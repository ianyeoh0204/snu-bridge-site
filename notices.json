  "roadmaps": {
    "note": "AI-draft planning guide from the cited ECE notices. Your cohort, approvals and the current semester’s rules still control; the department makes the final decision.",
    "masters": [
      {
        "title": "Complete ECE coursework requirements (수료)",
        "text": "Use the ECE self-check sheet and handbook. SNU’s completion simulator omits ECE internal rules. Outside-department/undergraduate credits need approval; the cap depends on entry cohort and Thesis Research credits.",
        "sources": [
          "56747",
          "58023",
          "58072"
        ]
      },
      {
        "title": "Pass both qualifying-exam components (논자시)",
        "text": "Check the major AND language component. The FAQ requires six eligible ECE graduate credits, excluding Thesis Research, S/U, specified modular seminars and carried-over credits. Check the current registration notice and your nationality-dependent language requirement; English coursework alone is not proof of an exemption.",
        "sources": [
          "56747",
          "58072",
          "57441"
        ]
      },
      {
        "title": "Meet the current research-output requirement",
        "text": "From Fall 2026: at least one conference/journal paper published or accepted; you are first author excluding the advisor, and the advisor is a coauthor. Submission alone and co-first authorship are excluded for master’s. Abstract-only conferences require peer review and signed confirmation. Get evidence before the result-paper deadline.",
        "sources": [
          "57963",
          "58072"
        ]
      },
      {
        "title": "Finish review, result papers and BOTH final submissions",
        "text": "Online application and paper documents, fee, manuscript/presentation, result papers, library PDF and office approval documents are separate stages. Fall results: master’s 14 December 2026 at 17:00. Office final papers close 22 January 2027 at 17:00, earlier than the library’s 1 February 23:59 cutoff.",
        "sources": [
          "58072",
          "58160"
        ]
      }
    ],
    "phd": [
      {
        "title": "Check completion credits and recognition",
        "text": "Use ECE’s self-check and handbook rather than assuming the university simulator includes departmental rules. Check cohort-dependent outside-department credit approval and the graduate-program cap on undergraduate credits.",
        "sources": [
          "56747",
          "58023",
          "58072"
        ]
      },
      {
        "title": "Pass the qualifying exam, then arrange preliminary review",
        "text": "Verify major and language passes. PhD preliminary review must finish by the semester before initial/final thesis review. The current preliminary-review notice targets August 2027 degrees; individual stage and timing still need checking.",
        "sources": [
          "58072",
          "58076"
        ]
      },
      {
        "title": "Meet BOTH PhD research-output conditions",
        "text": "An SCI(E)-level journal publication/acceptance AND an international conference paper, domestic journal paper or registered international patent are required under the current rule. First-author/advisor-coauthor conditions and any cohort exceptions need checking. Abstract-only output requires peer review and signed confirmation.",
        "sources": [
          "57963",
          "58072"
        ]
      },
      {
        "title": "Complete initial/final review and final thesis deposit",
        "text": "Prepare the five-member review process and degree-specific result documents. Fall PhD results: 21 December 2026 at 17:00. Office final papers close 22 January 2027 at 17:00; library PDF closes 1 February 23:59. Contact ECE BEFORE any deadline if an exception is needed.",
        "sources": [
          "58072",
          "58160"
        ]
      }
    ],
    "integrated": [
      {
        "title": "Verify integrated-program coursework and status",
        "text": "Use ECE’s self-check, handbook and cohort-specific approval rules. Do not substitute the master’s completion requirements. Coursework completion and degree conferral are different statuses.",
        "sources": [
          "56747",
          "58023"
        ]
      },
      {
        "title": "Check the integrated qualifying-exam route",
        "text": "Verify both major and language results and current registration rules. The historical Spring 2026 example requires integrated students to sit in their third registered semester; that example does not establish a later exam’s dates or your overall eligibility.",
        "sources": [
          "57441",
          "58072"
